# Copy to .env for local use or to app.env for Docker Compose.
# Replace every placeholder before exposing the application.
APP_TITLE=Dashboard de Finanzas
DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
DATABASE_PATH=./dashboard.db
UPLOADS_DIR=./uploads
BACKUPS_DIR=./backups
LOGS_DIR=./logs
MAX_CONTENT_LENGTH_MB=12
DEFAULT_CURRENCY=EUR
SESSION_LIFETIME_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SQLITE_TIMEOUT_SECONDS=30
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-the-generated-password-hash

# Optional market-price refresh
ENABLE_MARKET_PRICE_REFRESH=false
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
MARKET_PRICE_REFRESH_MINUTES=30

# Optional IMAP importer; keep disabled unless fully configured.
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed
EMAIL_ERROR_FOLDER=Error
EMAIL_POLL_INTERVAL=300
EMAIL_IMAP_TIMEOUT=60
